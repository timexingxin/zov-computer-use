{
  "name": "@zov/mcp-server",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server for local-first desktop automation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zov-cua-mcp": "./dist/bin/server.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin/server.js 2>/dev/null || true",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zov/core": "*",
    "@zov/platform-macos": "*",
    "@zov/platform-windows": "*",
    "@zov/platform-linux": "*"
  },
  "license": "Apache-2.0"
}
